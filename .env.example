# ===========================================
# Application Configuration
# ===========================================
CLUSTER_ID=1
HOST=0.0.0.0
PORT=8000
ROOT_PATH=/api/v1/flex
LOG_LEVEL=INFO

# ===========================================
# S3 Configuration
# ===========================================
# AWS region for S3 operations
AWS_REGION=us-east-1

# Optional: Custom S3 endpoint URL for MinIO/LocalStack
# Leave empty for real AWS S3
S3_ENDPOINT_URL=

# Default S3 bucket for DECOMP artifacts
DEFAULT_BUCKET=decomp-bucket

# ===========================================
# Processing Configuration
# ===========================================
# Base directory for temporary files
TEMP_DIR=/tmp/flexibilizador

# Zip compression level (0-9, higher = more compression)
ZIP_COMPRESSION_LEVEL=6

# Maximum age of temp directories before cleanup (hours)
MAX_TEMP_DIR_AGE_HOURS=24
